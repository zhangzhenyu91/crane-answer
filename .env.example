# WeChatPadPro Cloud Access Token（必填）
WECHATPADPRO_TOKEN=

# 可选覆盖项（默认值已可用，一般无需配置）
# WECHATPADPRO_API_BASE=https://api.wechatpadpro.com
# WECHATPADPRO_TICKET_PATH=/cloud/v1/Runtime/WebSocketTicket
# WECHATPADPRO_WS_URL=wss://api.wechatpadpro.com/ws/sync

# 置 1 时打印每条原始推送报文（调试用）
# LOG_RAW_MESSAGE=1

# Dify API 地址（所有群共用，默认即生产地址）
# DIFY_API_BASE=https://ai.j1net.com/v1

# Dify workflow 的 user 标识
# DIFY_USER=zhangzhenyu91

# Dify 调用超时（毫秒，blocking 模式会等 workflow 跑完）
# DIFY_TIMEOUT_MS=60000

# 监听的群与各自 Dify API Key 的映射，多个用英文逗号分隔
# 格式：群id1:app-key1,群id2:app-key2
# DIFY_GROUP_KEYS=4585133963@chatroom:app-xxxxxxxx,48895174608@chatroom:app-yyyyyyyy

# 发送者显示名的手动覆盖（可选，优先级最高）。默认通过群成员接口自动解析：群昵称 > 微信昵称 > wxid
# 格式：wxid1:显示名1,wxid2:显示名2
# SENDER_NAME_MAP=wxid_ojuh1y9iirh512:张三
