# Docker Compose 部署镜像完整地址（含标签）；本机 Node.js 开发无需此项
IMAGE=ccr.ccs.tencentyun.com/<命名空间>/crane-answer:latest

# Web 管理页与 API 同端口监听
HOST=0.0.0.0
PORT=3000

# 业务配置持久化目录；Docker Compose 的 ./data 会挂载到容器 /app/data
DATA_DIR=./data

# Web 管理员登录（部署时务必修改默认密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# WeChatPadPro、Dify、监听规则和发送者别名均在 Web 管理页配置。
# 旧版 WECHATPADPRO_* / DIFY_* / DIFY_GROUP_KEYS / SENDER_NAME_MAP / LOG_RAW_MESSAGE
# 仅在首次启动且 settings.json 不存在时自动迁移，之后以 Web 配置为准。
# 输电班组运维（treeWatch）规则需要监听账号自身 wxid（@检测与自身消息排除）：WECHATPADPRO_BOT_WXID，
# 同样可在 Web 管理页「接入设置」中配置。

# 壹匣后端对接（树障隐患记录直推 + 群内提问 Call Me）：
# POST {YIXIA_BASE_URL}/api/v1/treehazard/ingest 与 POST {YIXIA_BASE_URL}/api/v1/callme/ingest-chat
# 与壹匣（j1toolkit）部署在同一 Docker 外部网络 j1toolkit 时按容器名互通，如 http://j1toolkit
# （壹匣容器内外同端口默认 80，若其 PORT 自定义则带上端口，如 http://j1toolkit:3000）
# 任一留空则树障记录/删除的实时推送与「报送」群指令、管理页报送按钮、群内提问不可用
YIXIA_BASE_URL=
YIXIA_INGEST_TOKEN=
